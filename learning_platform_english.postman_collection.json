          "name": "Get Published Lessons by Course (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/lessons/course/1", "host": ["{{base_url}}"], "path": ["api","lessons","course","1"] }
          }
        },
        {
