{
  "info": {
    "_postman_id": "english-learning-platform-v1",
    "name": "English Learning Platform API",
    "description": "Complete REST API collection for English Learning Platform. Set {{base_url}} = http://localhost:8080 and {{token}} after login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "token",    "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\",\n  \"fullName\": \"Alice Smith\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.data.token);",
              "  console.log('Token saved:', json.data.token);",
              "}"
            ], "type": "text/javascript" }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.data.token);",
              "  console.log('Token saved:', json.data.token);",
              "}"
            ], "type": "text/javascript" }
          }]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}"
            ], "type": "text/javascript" }
          }]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/users/me", "host": ["{{base_url}}"], "path": ["api","users","me"] }
          }
        },
        {
          "name": "[ADMIN] Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/admin/users", "host": ["{{base_url}}"], "path": ["api","admin","users"] }
          }
        },
        {
          "name": "[ADMIN] Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/admin/users/1", "host": ["{{base_url}}"], "path": ["api","admin","users","1"] }
          }
        },
        {
          "name": "[ADMIN] Get Users by Role",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/admin/users/role/USER", "host": ["{{base_url}}"], "path": ["api","admin","users","role","USER"] }
          }
        },
        {
          "name": "[ADMIN] Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/admin/users/2", "host": ["{{base_url}}"], "path": ["api","admin","users","2"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alice Updated\",\n  \"role\": \"MANAGER\",\n  \"enabled\": true\n}"
            }
          }
        },
        {
          "name": "[ADMIN] Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/admin/users/3", "host": ["{{base_url}}"], "path": ["api","admin","users","3"] }
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get Active Courses (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/courses", "host": ["{{base_url}}"], "path": ["api","courses"] }
          }
        },
        {
          "name": "[MANAGER] Get All Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/courses/all", "host": ["{{base_url}}"], "path": ["api","courses","all"] }
          }
        },
        {
          "name": "Get Course by ID (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/courses/1", "host": ["{{base_url}}"], "path": ["api","courses","1"] }
          }
        },
        {
          "name": "Get Courses by Level (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/courses/level/BEGINNER", "host": ["{{base_url}}"], "path": ["api","courses","level","BEGINNER"] }
          }
        },
        {
          "name": "[MANAGER] Create Course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/courses", "host": ["{{base_url}}"], "path": ["api","courses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Business English\",\n  \"description\": \"English for professionals and business contexts\",\n  \"level\": \"INTERMEDIATE\",\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "[MANAGER] Update Course",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/courses/1", "host": ["{{base_url}}"], "path": ["api","courses","1"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Business English Updated\",\n  \"description\": \"Updated description\",\n  \"level\": \"UPPER_INTERMEDIATE\",\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "[ADMIN] Delete Course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/courses/1", "host": ["{{base_url}}"], "path": ["api","courses","1"] }
          }
        },
        {
          "name": "[MANAGER] Toggle Course Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/courses/1/toggle", "host": ["{{base_url}}"], "path": ["api","courses","1","toggle"] }
          }
        }
      ]
    },
    {
      "name": "Lessons",
      "item": [
